{
  "name": "movieapp",
  "version": "1.0.0",
  "private": true,
  "description": "Web app in stile Netflix per esplorare film e serie TV con le API di TMDB, in JavaScript vanilla.",
  "type": "module",
  "scripts": {
    "dev": "http-server . -p 4173 -c-1 -o",
    "lint": "eslint . && html-validate *.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "author": "Alexandru Dimofte",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5"
  }
}
